rules_version = '2';

// Reguły bazy strony Jajo: przepisy od czytelników, polubienia, komentarze, profile, forum i gry.
// Wklej całość w Firebase: Firestore Database → Reguły → Opublikuj.
//
// Kto co może:
//  - każdy czyta zatwierdzone przepisy, ich zdjęcia, liczniki polubień, komentarze i profile,
//  - gość (konto anonimowe albo konto e-mail z niepotwierdzonym adresem) może polubić przepis
//    i napisać komentarz bez linków,
//  - zalogowany (kontem Google albo e-mailem z potwierdzonym adresem) dodaje przepisy (trafiają
//    do moderacji), ma profil, widzi i usuwa swoje rzeczy,
//  - listę ulubionych przepisów widzi i zmienia tylko jej właściciel,
//  - na forum każdy czyta, a zalogowani zakładają wątki i odpisują; autor zamyka i poprawia swój wątek,
//  - w grach każdy gra, a zalogowani wpisują swój najlepszy wynik na tablicę (z kontrolą czasu gry),
//  - moderator (dokument w kolekcji „admins” o ID równym jego UID) zatwierdza, odrzuca i usuwa.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Gość: konto anonimowe albo konto e-mail, którego adres nie jest jeszcze potwierdzony.
    function isAnon() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        || (request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.get('email_verified', false) != true);
    }

    function isMember() {
      return signedIn() && !isAnon();
    }

    function isAdmin() {
      return isMember() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userDoc() {
      return /databases/$(database)/documents/uzytkownicy/$(request.auth.uid);
    }

    function counterDoc(key) {
      return /databases/$(database)/documents/reakcje/$(key);
    }

    function likeDoc(key) {
      return /databases/$(database)/documents/polubienia/$(request.auth.uid + '_' + key);
    }

    function validKey(key) {
      return key is string && key.matches('^[A-Za-z0-9-]{2,64}$');
    }

    function validRecipe(d) {
      return d.keys().hasAll(['name', 'category', 'intro', 'time', 'wait', 'difficulty', 'servings',
                              'minServings', 'ingredients', 'steps', 'tip', 'eggs', 'thumb', 'hasPhoto',
                              'authorUid', 'authorName', 'status', 'rejectReason', 'createdAt'])
        && d.keys().hasOnly(['name', 'category', 'intro', 'time', 'wait', 'difficulty', 'servings',
                             'minServings', 'ingredients', 'steps', 'tip', 'eggs', 'thumb', 'hasPhoto',
                             'authorUid', 'authorName', 'status', 'rejectReason', 'createdAt', 'reviewedAt'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.category in ['sniadania', 'obiady', 'przekaski', 'desery']
        && d.intro is string && d.intro.size() <= 220
        && d.time is int && d.time >= 1 && d.time <= 720
        && d.wait is string && d.wait.size() <= 40
        && d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 3
        && d.servings is int && d.servings >= 1 && d.servings <= 24
        && d.minServings is int && d.minServings >= 1 && d.minServings <= d.servings
        && d.ingredients is list && d.ingredients.size() >= 2 && d.ingredients.size() <= 40
        && d.steps is list && d.steps.size() >= 1 && d.steps.size() <= 30
        && d.tip is string && d.tip.size() <= 400
        // Strona jest o jajkach: przepis bez jajek nie przejdzie.
        && d.eggs is int && d.eggs >= 1 && d.eggs <= 60
        && d.thumb is string && d.thumb.size() <= 60000
        && d.hasPhoto is bool
        && d.authorName is string && d.authorName.size() >= 2 && d.authorName.size() <= 40
        && d.rejectReason is string && d.rejectReason.size() <= 300;
    }

    /* ---------- Przepisy od czytelników ---------- */

    match /przepisy/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin();

      // Nowy przepis zawsze czeka na moderację. Jeden przepis na 2 minuty na osobę. Goście nie dodają przepisów.
      allow create: if isMember()
        && validRecipe(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rejectReason == ''
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data)
        && getAfter(userDoc()).data.ostatni == request.time
        && (!exists(userDoc())
            || !('ostatni' in get(userDoc()).data)
            || get(userDoc()).data.ostatni < request.time - duration.value(2, 'm'));

      // Tylko moderator zmienia status. Treści przepisu nie zmienia nikt.
      allow update: if isAdmin()
        && validRecipe(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // Pełne zdjęcie przepisu, osobno, żeby lista ładowała się szybko.
    match /zdjecia/{id} {
      allow read: if (signedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin()
        || get(/databases/$(database)/documents/przepisy/$(id)).data.status == 'approved';

      // Zdjęcie dodaje się tylko razem z nowym przepisem, więc nie da się go podmienić po akceptacji.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['data', 'authorUid'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 450000
        && !exists(/databases/$(database)/documents/przepisy/$(id))
        && getAfter(/databases/$(database)/documents/przepisy/$(id)).data.authorUid == request.auth.uid;

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    /* ---------- Polubienia ---------- */

    // Licznik polubień przepisu. Zmienia się tylko o 1 i tylko razem z dokumentem polubienia.
    match /reakcje/{key} {
      allow read: if true;
      allow create: if signedIn()
        && validKey(key)
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes == 1
        && !exists(likeDoc(key))
        && existsAfter(likeDoc(key));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['likes'])
        && ((request.resource.data.likes == resource.data.likes + 1 && !exists(likeDoc(key)) && existsAfter(likeDoc(key)))
            || (request.resource.data.likes == resource.data.likes - 1 && exists(likeDoc(key)) && !existsAfter(likeDoc(key))));
    }

    // Jedno polubienie na osobę i przepis: ID dokumentu to „uid_przepis”.
    match /polubienia/{likeId} {
      // Własne polubienie można sprawdzić także wtedy, gdy jeszcze go nie ma (uid nie zawiera „_”).
      allow get: if signedIn() && likeId.split('_')[0] == request.auth.uid;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'key', 'at'])
        && request.resource.data.uid == request.auth.uid
        && validKey(request.resource.data.key)
        && likeId == request.auth.uid + '_' + request.resource.data.key
        && request.resource.data.at == request.time
        && getAfter(counterDoc(request.resource.data.key)).data.likes
           == (exists(counterDoc(request.resource.data.key)) ? get(counterDoc(request.resource.data.key)).data.likes : 0) + 1;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(counterDoc(resource.data.key)).data.likes == get(counterDoc(resource.data.key)).data.likes - 1;
    }

    /* ---------- Komentarze ---------- */

    match /komentarze/{id} {
      allow read: if true;

      // Gość podpisuje się jako „Niezalogowany użytkownik” i nie może wstawiać linków.
      // Każdy może napisać najwyżej jeden komentarz na 30 sekund.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['recipe', 'text', 'authorUid', 'authorName', 'anon', 'createdAt'])
        && validKey(request.resource.data.recipe)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 600
        && request.resource.data.anon == isAnon()
        && (isAnon()
            ? request.resource.data.authorName == '' && !request.resource.data.text.matches('(?is).*(https?:|www[.]).*')
            : request.resource.data.authorName is string && request.resource.data.authorName.size() >= 2 && request.resource.data.authorName.size() <= 40)
        && request.resource.data.createdAt == request.time
        && getAfter(userDoc()).data.komentarz == request.time
        && (!exists(userDoc())
            || !('komentarz' in get(userDoc()).data)
            || get(userDoc()).data.komentarz < request.time - duration.value(30, 's'));

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    /* ---------- Profile ---------- */

    // Zdjęcie profilowe i baner: '' (domyślne), 'custom' (własne) albo gotowe, np. 'p:pisanka'.
    function validImageRef(v) {
      return v is string && (v == '' || v == 'custom' || v.matches('^p:[a-z-]{2,30}$'));
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'bio', 'egg', 'joinedAt', 'avatar', 'banner'])
        && (!('avatar' in d) || validImageRef(d.avatar))
        && (!('banner' in d) || validImageRef(d.banner))
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.bio is string && d.bio.size() <= 300
        && d.egg in ['', 'na-miekko', 'mollet', 'na-twardo', 'sadzone', 'jajecznica', 'w-koszulce', 'omlet', 'faszerowane'];
    }

    match /profile/{uid} {
      allow read: if true;
      allow create: if isMember()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.joinedAt == request.time;
      allow update: if isMember()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'egg', 'avatar', 'banner']);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    // Własne zdjęcie profilowe i baner, osobno od profilu, żeby komentarze ładowały tylko małe awatary.
    function validImage(d, maxChars) {
      return d.keys().hasOnly(['data'])
        && d.data is string
        && d.data.size() <= maxChars
        && d.data.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
    }

    match /awatary/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid && validImage(request.resource.data, 60000);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    match /banery/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid && validImage(request.resource.data, 350000);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    /* ---------- Forum ---------- */

    function threadDoc(id) {
      return /databases/$(database)/documents/watki/$(id);
    }

    function replyDoc(id, rid) {
      return /databases/$(database)/documents/watki/$(id)/odpowiedzi/$(rid);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 40;
    }

    // Tagi wybiera się z listy (od 1 do 3 różnych), żeby wątki łatwo było filtrować.
    function validTags(tags) {
      return tags is list && tags.size() >= 1 && tags.size() <= 3
        && tags.toSet().size() == tags.size()
        && tags.toSet().hasOnly(['pytanie', 'gotowanie', 'przepisy', 'wypieki', 'zdrowie', 'kury', 'zakupy', 'pokaz', 'inne']);
    }

    function validThread(d) {
      return d.title is string && d.title.size() >= 5 && d.title.size() <= 120
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 5000
        && validTags(d.tags);
    }

    function validReplyText(t) {
      return t is string && t.size() >= 2 && t.size() <= 3000;
    }

    function isAuthor() {
      return isMember() && resource.data.authorUid == request.auth.uid;
    }

    match /watki/{id} {
      allow read: if true;

      // Nowy wątek: tylko zalogowani, najwyżej jeden na 2 minuty na osobę.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'text', 'tags', 'authorUid', 'authorName', 'createdAt',
                                                 'lastAt', 'lastName', 'lastReply', 'replies', 'closed', 'pinned'])
        && validThread(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastName == ''
        && request.resource.data.lastReply == ''
        && request.resource.data.replies == 0
        && request.resource.data.closed == false
        && request.resource.data.pinned == false
        && getAfter(userDoc()).data.watek == request.time
        && (!exists(userDoc())
            || !('watek' in get(userDoc()).data)
            || get(userDoc()).data.watek < request.time - duration.value(2, 'm'));

      allow update: if
        // Autor poprawia tytuł, treść albo tagi.
        (isAuthor()
          && changedKeys().hasOnly(['title', 'text', 'tags', 'editedAt'])
          && validThread(request.resource.data)
          && request.resource.data.editedAt == request.time)
        // Autor albo moderator zamyka wątek i otwiera go ponownie.
        || ((isAuthor() || isAdmin())
          && changedKeys().hasOnly(['closed'])
          && request.resource.data.closed is bool)
        // Moderator przypina wątek na górze listy.
        || (isAdmin()
          && changedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool)
        // Nowa odpowiedź: licznik rośnie o 1 tylko razem z nowym dokumentem odpowiedzi tej osoby.
        || (isMember()
          && resource.data.closed == false
          && changedKeys().hasOnly(['replies', 'lastAt', 'lastName', 'lastReply'])
          && request.resource.data.replies == resource.data.replies + 1
          && request.resource.data.lastAt == request.time
          && validName(request.resource.data.lastName)
          && request.resource.data.lastReply is string
          && request.resource.data.lastReply.matches('^[A-Za-z0-9]{10,40}$')
          && !exists(replyDoc(id, request.resource.data.lastReply))
          && getAfter(replyDoc(id, request.resource.data.lastReply)).data.authorUid == request.auth.uid);

      // Autor usuwa wątek, dopóki nikt nie odpisał. Moderator usuwa każdy (najpierw odpowiedzi).
      allow delete: if (isAuthor() && resource.data.replies == 0) || isAdmin();

      match /odpowiedzi/{rid} {
        allow read: if true;

        // Odpowiedź tylko w otwartym wątku i razem z licznikiem. Najwyżej jedna na 15 sekund na osobę.
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
          && validReplyText(request.resource.data.text)
          && request.resource.data.authorUid == request.auth.uid
          && validName(request.resource.data.authorName)
          && request.resource.data.createdAt == request.time
          && get(threadDoc(id)).data.closed == false
          && getAfter(threadDoc(id)).data.lastReply == rid
          && getAfter(threadDoc(id)).data.replies == get(threadDoc(id)).data.replies + 1
          && getAfter(userDoc()).data.odpowiedz == request.time
          && (!exists(userDoc())
              || !('odpowiedz' in get(userDoc()).data)
              || get(userDoc()).data.odpowiedz < request.time - duration.value(15, 's'));

        // Autor poprawia odpowiedź. Usunięcie (przez autora albo moderatora) zostawia napis „Odpowiedź usunięta”,
        // dzięki czemu licznik odpowiedzi się zgadza.
        allow update: if resource.data.get('deleted', false) == false
          && ((isAuthor()
                && changedKeys().hasOnly(['text', 'editedAt'])
                && validReplyText(request.resource.data.text)
                && request.resource.data.editedAt == request.time)
            || ((isAuthor() || isAdmin())
                && changedKeys().hasOnly(['text', 'deleted'])
                && request.resource.data.text == ''
                && request.resource.data.deleted == true));

        // Całkowicie usuwa tylko moderator, np. razem z całym wątkiem.
        allow delete: if isAdmin();
      }
    }

    /* ---------- Gry ---------- */

    function gameIds() {
      return ['lap-jajka', 'lot-kurczaka', 'jajo-2048', 'pary'];
    }

    // Najwyższy możliwy wynik w grze, żeby nikt nie wpisał dowolnej liczby.
    function maxScore(game) {
      return game == 'jajo-2048' ? 1000000
        : game == 'lap-jajka' ? 5000
        : game == 'lot-kurczaka' ? 2000
        : 3000;
    }

    // Najkrótszy możliwy czas gry (w milisekundach) potrzebny na dany wynik.
    function minMillis(game, score) {
      return game == 'lap-jajka' ? score * 100
        : game == 'lot-kurczaka' ? score * 500
        : game == 'jajo-2048' ? score * 3
        : 8000;
    }

    function sessionDoc() {
      return /databases/$(database)/documents/sesje_gier/$(request.auth.uid);
    }

    // Początek gry: serwer zapisuje godzinę startu. Wynik nie może przyjść szybciej, niż da się go zdobyć.
    match /sesje_gier/{uid} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['game', 'startedAt'])
        && request.resource.data.game in gameIds()
        && request.resource.data.startedAt == request.time;
    }

    // Tablice wyników: najlepszy wynik każdej osoby w danej grze. Zapis tylko lepszego wyniku,
    // tylko razem z usunięciem sesji tej gry (jedna gra, jeden wynik). Moderator usuwa oszustów.
    match /wyniki/{game}/gracze/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid
        && game in gameIds()
        && request.resource.data.keys().hasOnly(['score', 'name', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= maxScore(game)
        && (resource == null || request.resource.data.score > resource.data.score)
        && validName(request.resource.data.name)
        && request.resource.data.at == request.time
        && get(sessionDoc()).data.game == game
        && request.time.toMillis() - get(sessionDoc()).data.startedAt.toMillis() >= minMillis(game, request.resource.data.score)
        && !existsAfter(sessionDoc());
      allow delete: if isAdmin();
    }

    /* ---------- Ulubione przepisy ---------- */

    // Prywatna lista ulubionych przepisów: widzi i zmienia ją tylko właściciel konta.
    match /ulubione/{uid} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['przepisy'])
        && request.resource.data.przepisy is list
        && request.resource.data.przepisy.size() <= 300;
    }

    /* ---------- Pomocnicze ---------- */

    // Znaczniki czasu ostatniego przepisu i komentarza (ochrona przed zalewem spamu).
    match /uzytkownicy/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ostatni', 'komentarz', 'watek', 'odpowiedz'])
        && (!('ostatni' in request.resource.data) || request.resource.data.ostatni == request.time)
        && (!('komentarz' in request.resource.data) || request.resource.data.komentarz == request.time)
        && (!('watek' in request.resource.data) || request.resource.data.watek == request.time)
        && (!('odpowiedz' in request.resource.data) || request.resource.data.odpowiedz == request.time);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ostatni', 'komentarz', 'watek', 'odpowiedz'])
        && (!('ostatni' in changedKeys()) || request.resource.data.ostatni == request.time)
        && (!('komentarz' in changedKeys()) || request.resource.data.komentarz == request.time)
        && (!('watek' in changedKeys()) || request.resource.data.watek == request.time)
        && (!('odpowiedz' in changedKeys()) || request.resource.data.odpowiedz == request.time);
    }

    // Lista moderatorów. Dodaje się ją ręcznie w konsoli Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
