rules_version = '2';

// Reguły bazy strony Jajo: przepisy od czytelników, polubienia, komentarze i profile.
// Wklej całość w Firebase: Firestore Database → Reguły → Opublikuj.
//
// Kto co może:
//  - każdy czyta zatwierdzone przepisy, ich zdjęcia, liczniki polubień, komentarze i profile,
//  - gość (konto anonimowe albo konto e-mail z niepotwierdzonym adresem) może polubić przepis
//    i napisać komentarz bez linków,
//  - zalogowany (kontem Google albo e-mailem z potwierdzonym adresem) dodaje przepisy (trafiają
//    do moderacji), ma profil, widzi i usuwa swoje rzeczy,
//  - listę ulubionych przepisów widzi i zmienia tylko jej właściciel,
//  - moderator (dokument w kolekcji „admins” o ID równym jego UID) zatwierdza, odrzuca i usuwa.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Gość: konto anonimowe albo konto e-mail, którego adres nie jest jeszcze potwierdzony.
    function isAnon() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        || (request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.get('email_verified', false) != true);
    }

    function isMember() {
      return signedIn() && !isAnon();
    }

    function isAdmin() {
      return isMember() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userDoc() {
      return /databases/$(database)/documents/uzytkownicy/$(request.auth.uid);
    }

    function counterDoc(key) {
      return /databases/$(database)/documents/reakcje/$(key);
    }

    function likeDoc(key) {
      return /databases/$(database)/documents/polubienia/$(request.auth.uid + '_' + key);
    }

    function validKey(key) {
      return key is string && key.matches('^[A-Za-z0-9-]{2,64}$');
    }

    function validRecipe(d) {
      return d.keys().hasAll(['name', 'category', 'intro', 'time', 'wait', 'difficulty', 'servings',
                              'minServings', 'ingredients', 'steps', 'tip', 'eggs', 'thumb', 'hasPhoto',
                              'authorUid', 'authorName', 'status', 'rejectReason', 'createdAt'])
        && d.keys().hasOnly(['name', 'category', 'intro', 'time', 'wait', 'difficulty', 'servings',
                             'minServings', 'ingredients', 'steps', 'tip', 'eggs', 'thumb', 'hasPhoto',
                             'authorUid', 'authorName', 'status', 'rejectReason', 'createdAt', 'reviewedAt'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.category in ['sniadania', 'obiady', 'przekaski', 'desery']
        && d.intro is string && d.intro.size() <= 220
        && d.time is int && d.time >= 1 && d.time <= 720
        && d.wait is string && d.wait.size() <= 40
        && d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 3
        && d.servings is int && d.servings >= 1 && d.servings <= 24
        && d.minServings is int && d.minServings >= 1 && d.minServings <= d.servings
        && d.ingredients is list && d.ingredients.size() >= 2 && d.ingredients.size() <= 40
        && d.steps is list && d.steps.size() >= 1 && d.steps.size() <= 30
        && d.tip is string && d.tip.size() <= 400
        // Strona jest o jajkach: przepis bez jajek nie przejdzie.
        && d.eggs is int && d.eggs >= 1 && d.eggs <= 60
        && d.thumb is string && d.thumb.size() <= 60000
        && d.hasPhoto is bool
        && d.authorName is string && d.authorName.size() >= 2 && d.authorName.size() <= 40
        && d.rejectReason is string && d.rejectReason.size() <= 300;
    }

    /* ---------- Przepisy od czytelników ---------- */

    match /przepisy/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin();

      // Nowy przepis zawsze czeka na moderację. Jeden przepis na 2 minuty na osobę. Goście nie dodają przepisów.
      allow create: if isMember()
        && validRecipe(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rejectReason == ''
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data)
        && getAfter(userDoc()).data.ostatni == request.time
        && (!exists(userDoc())
            || !('ostatni' in get(userDoc()).data)
            || get(userDoc()).data.ostatni < request.time - duration.value(2, 'm'));

      // Tylko moderator zmienia status. Treści przepisu nie zmienia nikt.
      allow update: if isAdmin()
        && validRecipe(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // Pełne zdjęcie przepisu, osobno, żeby lista ładowała się szybko.
    match /zdjecia/{id} {
      allow read: if (signedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin()
        || get(/databases/$(database)/documents/przepisy/$(id)).data.status == 'approved';

      // Zdjęcie dodaje się tylko razem z nowym przepisem, więc nie da się go podmienić po akceptacji.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['data', 'authorUid'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 450000
        && !exists(/databases/$(database)/documents/przepisy/$(id))
        && getAfter(/databases/$(database)/documents/przepisy/$(id)).data.authorUid == request.auth.uid;

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    /* ---------- Polubienia ---------- */

    // Licznik polubień przepisu. Zmienia się tylko o 1 i tylko razem z dokumentem polubienia.
    match /reakcje/{key} {
      allow read: if true;
      allow create: if signedIn()
        && validKey(key)
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes == 1
        && !exists(likeDoc(key))
        && existsAfter(likeDoc(key));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['likes'])
        && ((request.resource.data.likes == resource.data.likes + 1 && !exists(likeDoc(key)) && existsAfter(likeDoc(key)))
            || (request.resource.data.likes == resource.data.likes - 1 && exists(likeDoc(key)) && !existsAfter(likeDoc(key))));
    }

    // Jedno polubienie na osobę i przepis: ID dokumentu to „uid_przepis”.
    match /polubienia/{likeId} {
      // Własne polubienie można sprawdzić także wtedy, gdy jeszcze go nie ma (uid nie zawiera „_”).
      allow get: if signedIn() && likeId.split('_')[0] == request.auth.uid;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'key', 'at'])
        && request.resource.data.uid == request.auth.uid
        && validKey(request.resource.data.key)
        && likeId == request.auth.uid + '_' + request.resource.data.key
        && request.resource.data.at == request.time
        && getAfter(counterDoc(request.resource.data.key)).data.likes
           == (exists(counterDoc(request.resource.data.key)) ? get(counterDoc(request.resource.data.key)).data.likes : 0) + 1;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(counterDoc(resource.data.key)).data.likes == get(counterDoc(resource.data.key)).data.likes - 1;
    }

    /* ---------- Komentarze ---------- */

    match /komentarze/{id} {
      allow read: if true;

      // Gość podpisuje się jako „Niezalogowany użytkownik” i nie może wstawiać linków.
      // Każdy może napisać najwyżej jeden komentarz na 30 sekund.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['recipe', 'text', 'authorUid', 'authorName', 'anon', 'createdAt'])
        && validKey(request.resource.data.recipe)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 600
        && request.resource.data.anon == isAnon()
        && (isAnon()
            ? request.resource.data.authorName == '' && !request.resource.data.text.matches('(?is).*(https?:|www[.]).*')
            : request.resource.data.authorName is string && request.resource.data.authorName.size() >= 2 && request.resource.data.authorName.size() <= 40)
        && request.resource.data.createdAt == request.time
        && getAfter(userDoc()).data.komentarz == request.time
        && (!exists(userDoc())
            || !('komentarz' in get(userDoc()).data)
            || get(userDoc()).data.komentarz < request.time - duration.value(30, 's'));

      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    /* ---------- Profile ---------- */

    // Zdjęcie profilowe i baner: '' (domyślne), 'custom' (własne) albo gotowe, np. 'p:pisanka'.
    function validImageRef(v) {
      return v is string && (v == '' || v == 'custom' || v.matches('^p:[a-z-]{2,30}$'));
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'bio', 'egg', 'joinedAt', 'avatar', 'banner'])
        && (!('avatar' in d) || validImageRef(d.avatar))
        && (!('banner' in d) || validImageRef(d.banner))
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.bio is string && d.bio.size() <= 300
        && d.egg in ['', 'na-miekko', 'mollet', 'na-twardo', 'sadzone', 'jajecznica', 'w-koszulce', 'omlet', 'faszerowane'];
    }

    match /profile/{uid} {
      allow read: if true;
      allow create: if isMember()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.joinedAt == request.time;
      allow update: if isMember()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'egg', 'avatar', 'banner']);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    // Własne zdjęcie profilowe i baner, osobno od profilu, żeby komentarze ładowały tylko małe awatary.
    function validImage(d, maxChars) {
      return d.keys().hasOnly(['data'])
        && d.data is string
        && d.data.size() <= maxChars
        && d.data.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
    }

    match /awatary/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid && validImage(request.resource.data, 60000);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    match /banery/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid && validImage(request.resource.data, 350000);
      allow delete: if (isMember() && request.auth.uid == uid) || isAdmin();
    }

    /* ---------- Ulubione przepisy ---------- */

    // Prywatna lista ulubionych przepisów: widzi i zmienia ją tylko właściciel konta.
    match /ulubione/{uid} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['przepisy'])
        && request.resource.data.przepisy is list
        && request.resource.data.przepisy.size() <= 300;
    }

    /* ---------- Pomocnicze ---------- */

    // Znaczniki czasu ostatniego przepisu i komentarza (ochrona przed zalewem spamu).
    match /uzytkownicy/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ostatni', 'komentarz'])
        && (!('ostatni' in request.resource.data) || request.resource.data.ostatni == request.time)
        && (!('komentarz' in request.resource.data) || request.resource.data.komentarz == request.time);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ostatni', 'komentarz'])
        && (!('ostatni' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.ostatni == request.time)
        && (!('komentarz' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.komentarz == request.time);
    }

    // Lista moderatorów. Dodaje się ją ręcznie w konsoli Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
